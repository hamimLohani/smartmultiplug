{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "!data.exists() || (auth != null && !data.child('claimed_by').exists()) || (newData.child('secret').val() === data.child('secret').val() && !data.child('claimed_by').exists())",
        "pairing_requests": {
          "$guestUid": {
            ".read": "auth != null && (auth.uid === $guestUid || root.child('devices').child($deviceId).child('claimed_by').val() === auth.uid)",
            ".write": "auth != null && (auth.uid === $guestUid || root.child('devices').child($deviceId).child('claimed_by').val() === auth.uid || (!data.exists() && newData.exists() && auth.uid === $guestUid))"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('devices').child($deviceId).child('claimed_by').val() === auth.uid || root.child('devices').child($deviceId).child('shared_members').child(auth.uid).val() === true)",
            ".write": "auth != null && (auth.uid === $uid || root.child('devices').child($deviceId).child('claimed_by').val() === auth.uid || root.child('devices').child($deviceId).child('shared_members').child(auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
