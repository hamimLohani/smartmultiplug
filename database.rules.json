{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('devices').child($deviceId).child('shared_members').child(auth.uid).val() === true)",
            ".write": "auth != null && (auth.uid === $uid || root.child('devices').child($deviceId).child('shared_members').child(auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
