# ── Firebase ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Firebase project values.
# Find these in: Firebase Console → Project Settings → Your apps → Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# WebSocket URL of your MQTT broker (e.g. HiveMQ Cloud)
# Format: wss://your-cluster.hivemq.cloud:8884/mqtt
VITE_MQTT_BROKER_URL=

# MQTT credentials
# ⚠ Security note: these are currently static credentials.
# For production, replace with a Cloud Function that issues
# short-lived, per-user scoped credentials. See README.md §Security.
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
